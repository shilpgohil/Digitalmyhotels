# DigitalMyHotels backend — environment variables reference
# Copy this file to .env and fill in real values.

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false

# Database (asyncpg connection string)
DATABASE_URL=postgresql+asyncpg://dmh:password@host:5432/digitalmyhotels

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-strong-random-hex

# UPI encryption — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
UPI_ENCRYPTION_KEY=change-me-fernet-key==

# ── Storage (CRITICAL — must NOT be "local" in production) ───────────────────
#
# "local" stores files on the server's ephemeral disk. On Render free tier or
# any containerised host, local files are WIPED on every restart/deploy.
# Staff profile photos and check-in selfies will disappear.
#
# Use Backblaze B2 (recommended — generous free tier, S3-compatible):
#
# 1. Create a Backblaze B2 account at backblaze.com
# 2. Create a bucket (e.g. "digitalmyhotels"), note its region
# 3. Create an Application Key with read/write access to that bucket
# 4. Fill in the values below and set STORAGE_BACKEND=b2
#
STORAGE_BACKEND=b2

# Backblaze B2 — S3-compatible endpoint
# Region examples: us-west-004 / eu-central-003 / ap-southeast-004
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_KEY_ID=your-backblaze-application-key-id
B2_APPLICATION_KEY=your-backblaze-application-key
B2_BUCKET_NAME=digitalmyhotels
B2_PUBLIC_BASE_URL=https://digitalmyhotels.s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004

# Cloudflare R2 (alternative — if you already use Cloudflare)
# STORAGE_BACKEND=r2
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key
# R2_SECRET_ACCESS_KEY=your-r2-secret-key
# R2_BUCKET_NAME=digitalmyhotels
# R2_PUBLIC_BASE_URL=https://pub-xxx.r2.dev

# ── Email (optional — "stub" silently drops emails) ──────────────────────────
EMAIL_BACKEND=stub
EMAIL_FROM=noreply@yourdomain.com
# RESEND_API_KEY=re_xxx  # if EMAIL_BACKEND=resend

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["https://digitalmyhotels.vercel.app"]
