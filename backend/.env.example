# DigitalMyHotels Backend — copy to .env and adjust all values before running
# ============================================================================

APP_NAME=DigitalMyHotels
APP_ENV=development
DEBUG=false
SQL_ECHO=false
API_V1_PREFIX=/api/v1

# ----------------------------------------------------------------------------
# Database (Neon — use postgresql+asyncpg:// connection string)
# IMPORTANT: for production use your Neon pooled connection URL
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://dmh:dmh_dev_password@127.0.0.1:5434/digitalmyhotels

# ----------------------------------------------------------------------------
# Auth
# SECRET_KEY: generate with → python -c "import secrets; print(secrets.token_urlsafe(48))"
# ----------------------------------------------------------------------------
SECRET_KEY=dev-secret-change-me-use-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_COOKIE_NAME=dmh_refresh
REFRESH_COOKIE_SECURE=false          # true in production (HTTPS only)
REFRESH_COOKIE_SAMESITE=lax          # none in production (cross-origin Vercel → Render)
REFRESH_COOKIE_DOMAIN=               # your Render domain in production

# ----------------------------------------------------------------------------
# UPI encryption key
# Generate with → python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ----------------------------------------------------------------------------
UPI_ENCRYPTION_KEY=dev-fernet-key-replace-with-real-fernet-key==

# ----------------------------------------------------------------------------
# CORS — set to your Vercel URL in production
# ----------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000"]

# ----------------------------------------------------------------------------
# Storage — choose one: local | b2 | r2
# For production: Backblaze B2 (free tier, Singapore region)
# ----------------------------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=.local-storage

# Backblaze B2 (RECOMMENDED for production — free tier)
# 1. Create a bucket in Backblaze B2 (Singapore: sg-sin-001)
# 2. Create an App Key with read/write access to that bucket
# 3. Enable "Public" bucket or use a signed URL approach
B2_ENDPOINT=https://s3.sg-sin-001.backblazeb2.com
B2_KEY_ID=                           # Application Key ID
B2_APPLICATION_KEY=                  # Application Key (secret)
B2_BUCKET_NAME=digitalmyhotels
B2_PUBLIC_BASE_URL=https://s3.sg-sin-001.backblazeb2.com/digitalmyhotels
B2_REGION=sg-sin-001

# Cloudflare R2 (alternative)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=digitalmyhotels
R2_PUBLIC_BASE_URL=

# ----------------------------------------------------------------------------
# Email
# For production: sign up at resend.com (free tier: 3000 emails/month)
# ----------------------------------------------------------------------------
EMAIL_BACKEND=stub
EMAIL_FROM=noreply@digitalmyhotels.in
RESEND_API_KEY=

# ----------------------------------------------------------------------------
# Rate limiting
# ----------------------------------------------------------------------------
RATE_LIMIT_LOGIN_PER_MINUTE=10
